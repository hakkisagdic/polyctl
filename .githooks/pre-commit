#!/bin/sh
# polyctl: polyctl-hook-v7 role=pre-commit binding=project-local
initial_cwd=$(CDPATH= cd -- . && pwd -P)
root="$initial_cwd"
POLYCTL_COMMIT_TOP="$initial_cwd"; export POLYCTL_COMMIT_TOP
case ${GIT_INDEX_FILE-} in
  ""|/*|[A-Za-z]:[\\/]*) ;;
  *) GIT_INDEX_FILE="$initial_cwd/$GIT_INDEX_FILE"; export GIT_INDEX_FILE ;;
esac
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_NOSYSTEM GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS
indexed=$(git --literal-pathspecs -C "$initial_cwd" ls-files -- .polyctl-project 2>/dev/null) || indexed=unread
headed=
git --literal-pathspecs -C "$initial_cwd" rev-parse --verify -q HEAD >/dev/null 2>&1 || headed=$?
case $headed in
  "") headed=$(git --literal-pathspecs -C "$initial_cwd" ls-tree --name-only HEAD -- .polyctl-project 2>/dev/null) || headed=unread ;;
  1) headed=unborn ;;
esac
if [ -z "$indexed$headed" ]; then
  headed=$(git --literal-pathspecs -C "$initial_cwd" log --all -1 --format=%H -- .polyctl-project 2>/dev/null) || headed=unread
fi
if [ -z "$indexed$headed" ]; then
  enrollment_common=$(git --literal-pathspecs -C "$initial_cwd" rev-parse --git-common-dir 2>/dev/null) || headed=unread
  [ -n "$enrollment_common" ] || headed=unread
  case $enrollment_common in /*|[A-Za-z]:[\\/]*) ;; *) enrollment_common="$initial_cwd/$enrollment_common" ;; esac
  if [ -e "$enrollment_common/polyctl-enrolled.json" ] || [ -L "$enrollment_common/polyctl-enrolled.json" ]; then
    headed=recorded
  fi
fi
[ -n "$indexed$headed" ] || exit 0
polyctl=$(command -v polyctl) || { echo 'polyctl: polyctl not found' >&2; exit 1; }
exec "$polyctl" -C "$root" commit-check
